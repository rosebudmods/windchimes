{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "icon": "assets/${id}/icon.png",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "sources": "${sources}",
    "issues": "${issues}"
  },
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.khazoda.windchimes.WindChimesFabric"
    ],
    "client": [
      "com.khazoda.windchimes.WindChimesFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "fabric-lifecycle-events-v1": "*",
    "fabric-resource-loader-v0": "*",
    "fabric-content-registries-v0": "*",
    "fabric-registry-sync-v0": "*",
    "fabric-object-builder-api-v1": "*",
    "fabric-item-group-api-v1": "*",
    "fabric-rendering-v1": "*",
    "minecraft": "${minecraft}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord}"
      }
    },
    "catalogue": {
      "banner": "assets/${id}/banner.png",
      "background": "assets/${id}/background.png"
    }
  }
}