{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "icon": "assets/${mod_id}/icon.png",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.khazoda.windchimes.WindChimesFabric"
    ],
    "client": [
      "com.khazoda.windchimes.WindChimesFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range_fabric}",
    "java": ">=${java_version}"
  },
  "custom": {
    "catalogue": {
      "banner": "assets/${mod_id}/banner.png",
      "background": "assets/${mod_id}/background.png"
    }
  }
}